# Только index.php должен быть точкой входа — остальные .php-файлы
# сами себя защищают константой SHINEMATE_ADMIN_BOOTSTRAP (403 при
# прямом обращении), но запрет на уровне сервера — вторая, независимая
# линия защиты на случай, если PHP-обработчик когда-нибудь отключат.
<FilesMatch "^(config|auth|catalog|mailer|media|diagnostics|audit|products|products-ui)\.php$">
  Require all denied
</FilesMatch>

# login-attempts.json, cred-version.txt, audit.log, otp-recovery.json
# и backups/ — служебные файлы, не для веб-доступа.
<FilesMatch "^(login-attempts\.json|cred-version\.txt|audit\.log|otp-recovery\.json)$">
  Require all denied
</FilesMatch>
<IfModule mod_alias.c>
  # Путь здесь ДОЛЖЕН совпадать с реальным путём развёртывания этой папки
  # на сервере (см. ADMIN_URL_PATH в config.php) — RedirectMatch сверяет
  # полный URL от корня сайта, а не путь относительно этого .htaccess.
  # Если папку переносят на другой путь, эту строку нужно поменять вместе.
  RedirectMatch 404 ^/sm-gkd2tpg4qp/backups/
</IfModule>

Options -Indexes -MultiViews

# Явно, а не полагаясь на дефолт хостинга: корень этой папки (без имени
# файла) должен открывать именно index.php.
DirectoryIndex index.php

# Страница входа/управления каталогом не должна попадать в индекс поиска —
# meta robots в index.php покрывает Google, заголовок ловит и остальных
# краулеров, которые meta-тег не читают вовсе. IfModule — если mod_headers
# почему-то не загружен на хостинге, сайт не должен падать 500-й ошибкой
# из-за одной строки в .htaccess.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
